{{define "content"}}
<div class="page">{{template "breadcrumbs" .Crumbs}}
  <header class="page-heading"><p class="eyebrow">Design, build, and grow</p><h1>Services &amp; solutions</h1><p class="lead">From a visual identity to a complete software product, find the expertise your business needs.</p></header>
  <div class="card-grid">{{range .Site.Services}}{{template "service-card" .}}{{end}}</div>
  {{template "workflow" .Site.Workflow}}
</div>
{{template "contact-callout" .}}
{{end}}
