{{define "content"}}
<section id="about" class="hero"><div class="container hero-grid">
  <div class="hero-copy"><p class="hero-intro">Hey, I am</p><h1>{{.Site.Config.Name}}</h1>
    <p>Hello, my name is Mohammed. You can call me TXO R. I am a developer and scientist from Algeria.</p>
    <p>I build high-quality, beautiful products that help businesses grow, combining development, marketing, graphic and UI/UX design, and automation.</p>
    <div class="button-row"><a class="button button-solid" href="{{route "contact"}}">Hire me</a><a class="button button-outline" href="{{route "projects"}}">Learn more</a></div>
  </div>
  <div class="hero-portrait"><img src="{{path "assets/images/portrait.svg"}}" alt="TXO R robot portrait with glowing purple eyes and a chest badge" width="700" height="700" fetchpriority="high"></div>
</div></section>
<section class="home-services"><div class="container">
  <div class="section-heading"><h2>What I do</h2><p>Explore my specialties and find the right service for your next product or business challenge.</p></div>
  <div class="service-links">{{range .Site.Services}}<a class="button button-outline" data-service="{{.ID}}" href="{{serviceURL .ID}}">{{.Name}}</a>{{end}}</div>
</div></section>
<section class="home-projects section-border"><div class="container">
  <div class="section-heading"><h2>Projects</h2><a class="text-link" href="{{route "projects"}}">Explore all projects →</a></div>
  <div class="card-grid">{{range .Projects}}{{template "project-card" .}}{{end}}</div>
</div></section>
{{if .Posts}}<section class="home-blog section-border"><div class="container"><div class="section-heading"><h2>From the blog</h2><a class="text-link" href="{{route "blog"}}">All articles →</a></div><div class="post-list">{{range .Posts}}{{template "post-card" .}}{{end}}</div></div></section>{{end}}
{{template "contact-callout" .}}
{{end}}
